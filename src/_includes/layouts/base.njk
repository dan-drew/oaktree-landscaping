<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }} | Oaktree Landscaping</title>
    <meta name="description" content="{{ description }}">
    <meta name="theme-color" content="#173f2a">
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    <link rel="icon" href="/assets/images/oaktree-logo-horizontal.png">

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:title" content="{{ title }} | Oaktree Landscaping">
    <meta property="og:description" content="{{ description }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta property="og:image" content="{{ site.url }}{{ socialImage or site.defaultImage }}">
    <meta property="og:image:alt" content="{{ socialImageAlt or 'Professional landscaping by Oaktree Landscaping' }}">
    <meta property="og:locale" content="en_US">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ title }} | Oaktree Landscaping">
    <meta name="twitter:description" content="{{ description }}">
    <meta name="twitter:image" content="{{ site.url }}{{ socialImage or site.defaultImage }}">
    <meta name="twitter:image:alt" content="{{ socialImageAlt or 'Professional landscaping by Oaktree Landscaping' }}">

    <link rel="stylesheet" href="/assets/vendor/bootstrap-icons/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/assets/css/styles.css">
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "@id": "{{ site.url }}/#business",
        "name": "{{ site.name }}",
        "url": "{{ site.url }}",
        "logo": "{{ site.url }}/assets/images/oaktree-logo-horizontal.png",
        "image": "{{ site.url }}{{ site.defaultImage }}",
        "email": "{{ site.email }}",
        "foundingDate": "2018",
        "priceRange": "$$",
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
            "opens": "09:00",
            "closes": "17:00"
          }
        ],
        "areaServed": [
          { "@type": "City", "name": "Bluffton, South Carolina" },
          { "@type": "City", "name": "Beaufort, South Carolina" },
          { "@type": "City", "name": "Hardeeville, South Carolina" }
        ],
        "sameAs": [{% for profile in site.social %}"{{ profile.url }}"{% if not loop.last %},{% endif %}{% endfor %}]
      }
    </script>
    {% if site.analyticsId %}
      <!-- Set site.analyticsId in src/_data/site.js to enable Google Analytics. -->
      <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.analyticsId }}"></script>
      <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag("js", new Date());
        gtag("config", "{{ site.analyticsId }}");
      </script>
    {% endif %}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {% include "partials/header.njk" %}
    <main id="main">
      {{ content | safe }}
    </main>
    {% include "partials/footer.njk" %}
    <script src="/assets/js/site.js" defer></script>
  </body>
</html>
